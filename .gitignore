# ──────────────────────────────────────────────
# DecisionGuard AI — .gitignore
# ──────────────────────────────────────────────

# ── Secrets ────────────────────────────────────
.env
.env.*
!.env.example

# ── Python ─────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
*.egg
.eggs/
*.whl

# ── Virtual environments ──────────────────────
venv/
.venv/
env/
ENV/

# ── IDE / Editor ──────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ── Testing / Coverage ───────────────────────
.pytest_cache/
htmlcov/
.coverage
*.cover

# ── Misc ──────────────────────────────────────
*.log
*.db
decisionguard.db
*.pdf
failed_output.txt
data/
